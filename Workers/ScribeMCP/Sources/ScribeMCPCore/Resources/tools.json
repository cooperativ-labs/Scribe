[
 {
  "name": "scribe_recent_transcripts",
  "title": "Recent Scribe transcripts",
  "description": "List the newest saved transcript per meeting, newest processing run first. Dates filter transcript creation time. Does not include transcript text; retrieve the selected ID before analysis. before is exclusive.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "limit": {
     "default": 10,
     "type": "integer",
     "minimum": 1,
     "maximum": 50
    },
    "offset": {
     "default": 0,
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "after": {
     "type": "string",
     "format": "date-time",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "before": {
     "type": "string",
     "format": "date-time",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
   },
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
   "type": "object",
   "properties": {
    "transcripts": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "created_at": {
        "type": "string"
       },
       "processed_at": {
        "type": "string"
       },
       "revision": {
        "type": "number"
       },
       "duration_ms": {
        "type": "number"
       },
       "language": {
        "type": "string"
       },
       "status": {
        "type": "string"
       },
       "speakers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "url": {
        "type": "string"
       },
       "excerpt": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "created_at",
       "processed_at",
       "revision",
       "duration_ms",
       "language",
       "status",
       "speakers",
       "url"
      ],
      "additionalProperties": false
     }
    },
    "total": {
     "type": "number"
    },
    "next_offset": {
     "type": [
      "number",
      "null"
     ]
    },
    "skipped_runs": {
     "type": "number"
    }
   },
   "required": [
    "transcripts",
    "total",
    "next_offset",
    "skipped_runs"
   ],
   "$schema": "http://json-schema.org/draft-07/schema#",
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "_meta": {
   "securitySchemes": [
    {
     "type": "noauth"
    }
   ],
   "ui": {
    "resourceUri": "ui://scribe/transcripts-v1.html"
   },
   "openai/outputTemplate": "ui://scribe/transcripts-v1.html",
   "openai/toolInvocation/invoking": "Reading Scribe transcripts",
   "openai/toolInvocation/invoked": "Scribe transcripts ready"
  }
