# Copy to Scripts/release-inputs.local.env, replace every placeholder with an
# approved local path, and invoke Scripts/package-app.sh --inputs that file.
# This file intentionally contains no credentials or model download URLs.

export DEVELOPER_ID_APPLICATION='Developer ID Application: Example, Inc. (TEAMID)'
export DEVELOPER_TEAM_ID='TEAMID'
export NOTARYTOOL_PROFILE='scribe-notary'

# Reviewed, pinned executable inputs; helpers are embedded in Scribe.app.
export SCRIBE_FFMPEG_PATH='/absolute/path/to/ffmpeg'
export SCRIBE_FFPROBE_PATH='/absolute/path/to/ffprobe'
export SCRIBE_RUNTIME_PAYLOADS_DIR='/absolute/path/to/runtime-frameworks-and-dylibs'
# Set SCRIBE_TRANSCRIPTION_WORKER_PATH only when using a prebuilt worker.
# export SCRIBE_TRANSCRIPTION_WORKER_PATH='/absolute/path/to/TranscriptionWorker'

# Committed attribution/terms. These default to the in-repo notices.
export SCRIBE_NOTICE_WEBRTC="$PWD/Native/WebRTCBridge/Licenses/webrtc-LICENSE.txt"
export SCRIBE_NOTICE_FLUIDAUDIO="$PWD/Workers/TranscriptionWorker/Licenses/FluidAudio.txt"
export SCRIBE_NOTICE_PARAKEET="$PWD/Workers/TranscriptionWorker/Licenses/Parakeet-CC-BY-4.0.txt"
export SCRIBE_NOTICE_DIARIZATION="$PWD/Workers/TranscriptionWorker/Licenses/Diarization-Models.txt"
export SCRIBE_NOTICE_FFMPEG="$PWD/Native/FFmpeg/FFmpeg.txt"
# export SCRIBE_LIBFLAC_BUNDLED=1
# export SCRIBE_NOTICE_LIBFLAC='/absolute/path/to/libFLAC-COPYING'

# The development source for model catalog/assets. Production model payloads
# install into ~/Library/Application Support/Scribe/Models (or an explicitly
# user-selected folder), never into the signed app bundle.
export SCRIBE_MODEL_SOURCE_DIR="$HOME/Development/Models/Scribe"
# A signed catalog is optional until the model installer exists.
# export SCRIBE_MODEL_CATALOG_FILE="$SCRIBE_MODEL_SOURCE_DIR/model-catalog.json"
