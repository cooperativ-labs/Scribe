# Overlord session scratch. Keep .overlord/project.json tracked.
.overlord/tmp/
.overlord/logs/

# Local secrets and operator-only release inputs. Keep *.example.env tracked.
.env
.env.*
!.env.example
*.local.env

# Local mise overrides
mise.local.toml

# macOS
.DS_Store
._*

# Editor swap files
*~
*.swp
*.swo

# Xcode user data and local results. Shared schemes and Package.resolved stay tracked.
xcuserdata/
*.xcuserstate
*.xcresult
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift package build products and generated workspaces.
.build/
.swiftpm/

# Release archives and xcodebuild output (Scripts/package-app.sh).
build/

# Python bytecode from harness scoring scripts and native meson/ninja toolchains.
__pycache__/
*.py[cod]
.venv/

# Pinned native dependencies: sources, build trees, and install prefixes
# are produced by Scripts/build-native-dependencies.sh, never committed.
Native/*/Vendor/cache/
Native/*/Vendor/build/
Native/*/Vendor/prefix/
Native/*/Vendor/toolchain/

# Pinned FFmpeg sources, build trees, and install prefix are regenerated by Scripts/build-ffmpeg.sh.
Native/FFmpeg/cache/
Native/FFmpeg/build/
Native/FFmpeg/prefix/

# Raw capture-harness sessions: JSONL journals and float32 CAF originals. Committed
# fixtures live in Tests/Fixtures/real/; fixture.json records the raw session path.
captures/
Tools/CaptureHarness/captures/

# Ad-hoc signed harness bundles. Rebuilt by Tools/*/Scripts/build-signed.sh;
# cdhash changes on every build, so they are never committed artifacts.
Tools/*/bin/

# Development-only model snapshots downloaded by Scripts/package-transcription-models.sh.
# Workers/TranscriptionWorker/models/.gitignore also enforces this.
Workers/TranscriptionWorker/models/*
!Workers/TranscriptionWorker/models/.gitignore


/dist