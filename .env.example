# Copy this file to .env. It is read only by Scripts/release-app.sh; do not
# commit .env. The Developer ID certificate itself must already be installed in
# the login keychain.

# The exact Developer ID Application identity shown by `security find-identity
# -v -p codesigning`.
DEVELOPER_ID_APPLICATION='Developer ID Application: Example, Inc. (TEAMID)'

# A unique local keychain profile name for the Apple notary credentials.
NOTARYTOOL_PROFILE='scribe-notary'

# Apple account credentials used once per release to create the keychain
# profile above. Use an app-specific password, never the Apple ID password.
APPLE_ID='name@example.com'
APPLE_APP_SPECIFIC_PASSWORD='xxxx-xxxx-xxxx-xxxx'
APPLE_TEAM_ID='TEAMID'
