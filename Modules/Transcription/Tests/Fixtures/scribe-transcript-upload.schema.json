{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge.local/schemas/kb.transcript-upload-1.json",
  "title": "Knowledgebase transcript upload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "segments"],
  "properties": {
    "schema": { "const": "kb.transcript-upload/1" },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processed_at": { "type": "string", "format": "date-time" },
        "language": { "type": "string", "minLength": 1 }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "start_ms", "end_ms"],
        "properties": {
          "speaker": {
            "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "text": { "type": "string", "minLength": 1 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
